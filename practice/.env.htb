# Lab Coach под Hack The Box (VPN внутри Kali VM).
# Скопировать:  cp practice/.env.htb .env   и вписать свой ADMIN_IDS.
# Один явно заспавненный docker-челлендж с публичным IP — в SPAWNED_TARGET
# на время сессии, потом очистить. Пусто = public запрещён всегда.

ADMIN_IDS=
LAB_PLATFORM=htb
REQUIRE_VPN=true
SPAWNED_TARGET=
MAX_SCANS_PER_HOUR=20

ALLOWED_LAB_CIDRS=10.10.10.0/23,10.129.0.0/16
ALLOW_LOOPBACK=false

NUCLEI_PATH=nuclei
NMAP_ENABLED=false
SCAN_TIMEOUT_SECONDS=900

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
LLM_ENABLED=true
LLM_PROVIDER=openrouter
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_API_KEY=

BOT_TOKEN=
ENVIRONMENT=lab
LOG_LEVEL=INFO
DATABASE_URL=sqlite+aiosqlite:///./data/lab.db
