# Готовый .env для домашнего полигона (Metasploitable 2 в host-only).
# Скопировать:  cp practice/.env.metasploitable .env   и вписать свой ADMIN_IDS.

ADMIN_IDS=
LAB_PLATFORM=metasploitable
REQUIRE_VPN=false
SPAWNED_TARGET=
MAX_SCANS_PER_HOUR=20

ALLOWED_LAB_CIDRS=192.168.56.0/24
ALLOW_LOOPBACK=false

NUCLEI_PATH=nuclei
NMAP_ENABLED=false
SCAN_TIMEOUT_SECONDS=900

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
LLM_ENABLED=false

BOT_TOKEN=
ENVIRONMENT=lab
LOG_LEVEL=INFO
DATABASE_URL=sqlite+aiosqlite:///./data/lab.db
