# Kali атакующего. NAT (адаптер 1) + host-only vboxnet0 по DHCP (адаптер 2, дорога к PlanBox).
# vboxnet0 192.168.56.0/24 должен существовать (см. LAB-VM-GUIDE, шаг 1).
Vagrant.configure("2") do |config|
  config.vm.box = "kalilinux/rolling"
  config.vm.hostname = "kali-attacker"
  config.vm.network "private_network", type: "dhcp"
  config.vm.provider "virtualbox" do |vb|
    vb.name = "kali-attacker"
    vb.memory = 4096
    vb.cpus = 2
    vb.gui = false
  end
  # setup.sh идёт от непривилегированного пользователя (внутри sudo).
  config.vm.provision "shell", path: "setup.sh", privileged: false
end
