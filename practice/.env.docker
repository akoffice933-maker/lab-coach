# Lab Coach + docker compose Juice Shop (сеть 172.30.0.0/24).
# cp practice/.env.docker .env

ADMIN_IDS=1
LAB_PLATFORM=custom
REQUIRE_VPN=false
SPAWNED_TARGET=
MAX_SCANS_PER_HOUR=20

ALLOWED_LAB_CIDRS=172.30.0.0/24
ALLOW_LOOPBACK=false

NUCLEI_PATH=nuclei
NMAP_ENABLED=false
SCAN_TIMEOUT_SECONDS=300

LLM_ENABLED=false
LLM_PROVIDER=ollama
HTB_DIR=~/HTB
AGENT_ROLE=coach
SOFT_HINTS=true

ENVIRONMENT=lab
LOG_LEVEL=INFO
DATABASE_URL=sqlite+aiosqlite:///./data/lab.db
MCP_TRANSPORT=stdio
