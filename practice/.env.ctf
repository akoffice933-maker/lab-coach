# Lab Coach под CTF-арену HTB (Try Out / ивенты).
# Скопировать:  cp practice/.env.ctf .env   и вписать ADMIN_IDS + SPAWNED_TARGET.
# SPAWNED_TARGET — IP:port СВОЕГО заспавненного инстанса из карточки таска
# (docker-инстансы публичные, VPN не нужен). Один инстанс на сессию.
# Пустой SPAWNED_TARGET = любой скан запрещён. Остальное не трогать.

ADMIN_IDS=
LAB_PLATFORM=ctf
REQUIRE_VPN=false
SPAWNED_TARGET=203.0.113.50:8080
MAX_SCANS_PER_HOUR=20

ALLOWED_LAB_CIDRS=
ALLOW_LOOPBACK=false

NUCLEI_PATH=nuclei
NMAP_ENABLED=false
SCAN_TIMEOUT_SECONDS=300

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
LLM_ENABLED=true
LLM_PROVIDER=openrouter
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_API_KEY=

AGENT_ROLE=coach
HTB_DIR=~/HTB

BOT_TOKEN=
ENVIRONMENT=ctf
LOG_LEVEL=INFO
DATABASE_URL=sqlite+aiosqlite:///./data/lab.db
